# Data and derived artifacts
data/
# The console reads this at request time and Vercel builds from the repository, so
# an ignored export means the deployment fails at build rather than rendering
# empty. Negated after the broad data/ rule, which caught it as collateral. D69.
!apps/console/public/data/
!apps/console/public/data/**
*.duckdb
*.duckdb.wal
*.parquet
ml/artifacts/

# Figures are generated. Commit one deliberately with git add -f.
docs/figures/*.png
docs/figures/*.pdf
!docs/figures/.gitkeep

# Credentials
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# uv regenerates this from pyproject.toml, whose direct dependencies are pinned.
# The full environment behind the published results is requirements.lock.txt.
uv.lock

# Node
node_modules/
.next/
out/
.vercel/

# OS and editor
.DS_Store
.idea/
*.swp

# Copied from node_modules at build, see scripts/copy-map-worker.mjs.
apps/console/public/maplibre/

# NASA FIRMS map key. Request one at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# MOSDAC credentials for INSAT-3DS L1B, needed from phase 5 onward.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# AgniNetra Live community labelling. A Google OAuth web client ID whose authorised
# redirect URI is the site's root, and a random secret of at least 32 characters that
# must match the one the qualifying pack was built with.
GOOGLE_CLIENT_ID=
QUALIFY_SECRET=
